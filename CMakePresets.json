{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "macos-arm64-tests-debug",
      "displayName": "macOS ARM64 portable tests (Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "OPENTS_PORTABLE_TESTS_ONLY": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-tests-release",
      "displayName": "macOS ARM64 portable tests (Release)",
      "inherits": "macos-arm64-tests-debug",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-arm64-shell-debug",
      "displayName": "macOS ARM64 desktop window (Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-shell-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "OPENTS_MACOS_SHELL_ONLY": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-shell-release",
      "displayName": "macOS ARM64 desktop window (Release)",
      "inherits": "macos-arm64-shell-debug",
      "binaryDir": "${sourceDir}/build/macos-shell-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64-tests-debug", "configurePreset": "macos-arm64-tests-debug" },
    { "name": "macos-arm64-tests-release", "configurePreset": "macos-arm64-tests-release" },
    { "name": "macos-arm64-shell-debug", "configurePreset": "macos-arm64-shell-debug", "targets": ["OpenTSMacShell"] },
    { "name": "macos-arm64-shell-release", "configurePreset": "macos-arm64-shell-release", "targets": ["OpenTSMacShell"] }
  ],
  "testPresets": [
    {
      "name": "macos-arm64-tests-debug",
      "configurePreset": "macos-arm64-tests-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-arm64-tests-release",
      "configurePreset": "macos-arm64-tests-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
