# Build output
[Bb]uild/
/Run/*
!/Run/place_game_data_here

# Editors and language servers
*~
*.bak
*.swp
*.code-workspace
.idea/
.vscode/
.history/
/.cache/
/.clangd
/compile_commands.json

# Python bytecode
__pycache__/
*.pyc

# Manual tooling temp snapshots (interrupted manage.py runs)
manual/data/.manual-check-*/
manual/data/.manual-generate-*/

# Agent worktrees, which are checkouts of this repository placed inside it
/.claude/worktrees/

# Owner-local documents (untracked adjudication material)
/docs/local/

# Xcode per-user state
xcuserdata/
.DS_Store

# Game data. The original disc images and archives are kept locally, never in Git.
*.iso
*.ISO
*.mix
*.MIX
